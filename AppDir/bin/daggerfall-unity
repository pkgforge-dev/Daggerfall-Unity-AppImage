#!/bin/sh
export SHARUN_DIR=$APPDIR

_data_dir=$APPDIR/bin/data
_save_dir=${XDG_DATA_HOME:-$HOME/.local/share}/daggerfall-unity/save
_config_dir=${XDG_CONFIG_HOME:-$HOME/.config}/unity3d/'Daggerfall Workshop'/'Daggerfall Unity'
_config_file=$_config_dir/settings.ini

mkdir -p "$_config_dir" "$_save_dir"
if [ ! -f "$_config_file" ] || ! grep -q '^MyDaggerfallPath' "$_config_file"; then
    printf '[Daggerfall]\nMyDaggerfallPath = %s\nMyDaggerfallUnitySavePath = %s\n' "$_data_dir" "$_save_dir" > "$_config_file"
else
    sed -i "s|^MyDaggerfallPath *=.*|MyDaggerfallPath = $_data_dir|" "$_config_file"
fi

exec "$APPDIR"/bin/engine/DaggerfallUnity.x86_64 "$@"
